{% comment %}
  shopdev-pdp-styles
  Style-only section for the BKM Electrolytes PDP. Emits a scoped <style> block so we can
  exceed the 500-char limit of a section's custom_css. Renders no visible markup.
  Currently: premium flavour-card styling for the enhanced variant selector.
{% endcomment %}

{%- style -%}
  .enhanced-variant-selector__title { font-size: 15px; font-weight: 700; color: #0A2240; margin-bottom: 10px; }
  .enhanced-variant-selector__buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .enhanced-variant-button {
    display: flex; align-items: center; gap: 10px;
    padding: 14px 16px; border: 1.5px solid #e3e6ea; border-radius: 14px;
    background: #fff; cursor: pointer; text-align: left; width: 100%;
    transition: border-color .18s ease, box-shadow .18s ease;
  }
  .enhanced-variant-button::before {
    content: ''; width: 18px; height: 18px; border-radius: 50%; flex: 0 0 auto;
    background: rgba(10,34,64,.15);
  }
  .enhanced-variant-button:nth-child(1)::before { background: radial-gradient(circle at 30% 30%, #c1457f, #7d2b6b); }
  .enhanced-variant-button:nth-child(2)::before { background: radial-gradient(circle at 30% 30%, #9ccb5a, #4f9d3a); }
  .enhanced-variant-button:hover { border-color: #0A2240; }
  .enhanced-variant-button--active { border-color: #0A2240; box-shadow: 0 0 0 2px #0A2240; }
  .enhanced-variant-button__name { font-weight: 600; color: #0A2240; font-size: 15px; }
{%- endstyle -%}

{% schema %}
{
  "name": "PDP Styles",
  "tag": "section",
  "settings": [],
  "disabled_on": { "groups": ["header", "aside", "footer"] }
}
{% endschema %}
