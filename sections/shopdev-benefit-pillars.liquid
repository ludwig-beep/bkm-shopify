{% comment %}
  shopdev-benefit-pillars
  "More than hydration" — BKM Electrolytes benefit pillars (daily wellness hydration).
  Self-contained. Brand: BKM Blue (#0A2240), inherits theme body font (Avenir).
  Each block = one pillar: icon (text/emoji) + title + description.
{% endcomment %}

{%- liquid
  assign accent = section.settings.accent_color | default: '#0A2240'
  assign bg = section.settings.bg_color | default: '#f7f9fa'
  assign uid = section.id
-%}

{%- style -%}
  #ElytePillars--{{ uid }} {
    --p-accent: {{ accent }};
    background: {{ bg }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #ElytePillars--{{ uid }} .pillars__inner { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
  #ElytePillars--{{ uid }} .pillars__head { text-align: center; margin-bottom: 40px; }
  #ElytePillars--{{ uid }} .pillars__eyebrow { font-size: 13px; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; color: var(--p-accent); opacity: .7; margin: 0 0 10px; }
  #ElytePillars--{{ uid }} .pillars__title { font-size: clamp(28px, 4.4vw, 44px); line-height: 1.08; margin: 0 0 14px; color: var(--p-accent); }
  #ElytePillars--{{ uid }} .pillars__sub { font-size: 17px; line-height: 1.6; max-width: 680px; margin: 0 auto; opacity: .82; }
  #ElytePillars--{{ uid }} .pillars__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  #ElytePillars--{{ uid }} .pillars__card {
    background: #fff; border: 1px solid rgba(10,34,64,.1); border-radius: 18px;
    padding: 28px 24px; box-shadow: 0 14px 44px -26px rgba(10,34,64,.4);
  }
  #ElytePillars--{{ uid }} .pillars__icon { font-size: 30px; line-height: 1; margin-bottom: 14px; display: block; }
  #ElytePillars--{{ uid }} .pillars__cardtitle { font-size: 19px; font-weight: 700; margin: 0 0 8px; color: var(--p-accent); }
  #ElytePillars--{{ uid }} .pillars__text { font-size: 15px; line-height: 1.55; margin: 0; opacity: .82; }
  @media (max-width: 860px) { #ElytePillars--{{ uid }} .pillars__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { #ElytePillars--{{ uid }} .pillars__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}

<section id="ElytePillars--{{ uid }}" class="shopdev shopdev-benefit-pillars" data-section-id="{{ uid }}">
  <div class="pillars__inner">
    <div class="pillars__head">
      {%- if section.settings.eyebrow != blank -%}<p class="pillars__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="pillars__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<div class="pillars__sub">{{ section.settings.subheading }}</div>{%- endif -%}
    </div>
    <div class="pillars__grid">
      {%- for block in section.blocks -%}
        <div class="pillars__card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}<span class="pillars__icon">{{ block.settings.icon }}</span>{%- endif -%}
          {%- if block.settings.title != blank -%}<h3 class="pillars__cardtitle">{{ block.settings.title }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<p class="pillars__text">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefit Pillars",
  "class": "shopdev shopdev-benefit-pillars",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "More than hydration" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One serving. Five ways it works for you." },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Where most electrolytes only chase hydration, BKM is built as a daily wellness formula — hydration, energy, immunity, antioxidant protection and gut health in one sugar-free serving.</p>" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#0A2240" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#f7f9fa" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji or text)", "default": "💧" },
        { "type": "text", "id": "title", "label": "Title", "default": "Advanced hydration" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Guérande sea salt, sodium citrate, potassium, magnesium and calcium — plus coconut water powder — help maintain fluid balance and replenish minerals lost through sweat." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Benefit Pillars",
      "blocks": [
        { "type": "pillar", "settings": { "icon": "💧", "title": "Advanced hydration", "text": "Guérande sea salt, sodium citrate, potassium, magnesium and calcium — plus coconut water powder — help maintain fluid balance and replenish minerals lost through sweat." } },
        { "type": "pillar", "settings": { "icon": "⚡", "title": "Energy & muscle", "text": "Magnesium contributes to normal energy metabolism and helps reduce tiredness and fatigue. Potassium, calcium and magnesium support normal muscle function." } },
        { "type": "pillar", "settings": { "icon": "🛡️", "title": "Immune & antioxidant", "text": "Vitamin C from acerola, selenium and Vitamin D3 support normal immune function. NAC supports glutathione production; Vitamin C and selenium help protect cells from oxidative stress." } },
        { "type": "pillar", "settings": { "icon": "🌱", "title": "Gut health", "text": "Inulin from chicory root acts as a prebiotic fibre that nourishes beneficial gut bacteria, while the clinically studied LactoSpore® probiotic supports a healthy gut microbiome." } },
        { "type": "pillar", "settings": { "icon": "🍋", "title": "Naturally flavoured, sugar-free", "text": "Swedish-rooted flavours, naturally sweetened with stevia, with no added sugar — so it's something you'll actually want every day." } },
        { "type": "pillar", "settings": { "icon": "🇸🇪", "title": "Made in Sweden", "text": "Developed over a year by Swedish former top athletes, with carefully sourced ingredients and Cologne List® testing for banned substances." } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "aside", "footer"] }
}
{% endschema %}
