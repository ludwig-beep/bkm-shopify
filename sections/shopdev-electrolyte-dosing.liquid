{% comment %}
  shopdev-electrolyte-dosing
  Signature "scales with your effort" module for the BKM Electrolytes PDP.
  Self-contained (no external deps). Brand: BKM Blue (#0A2240), inherits theme body font (Avenir).
  Each block is a dose level: N stick icons + label + description (1 = everyday, 2 = training, 3 = hardest).
{% endcomment %}

{%- liquid
  assign accent = section.settings.accent_color | default: '#0A2240'
  assign bg = section.settings.bg_color
  assign uid = section.id
-%}

{%- style -%}
  #ElyteDose--{{ uid }} {
    --dose-accent: {{ accent }};
    --dose-pt: {{ section.settings.padding_top }}px;
    --dose-pb: {{ section.settings.padding_bottom }}px;
    {%- if bg != blank and bg != 'rgba(0,0,0,0)' -%}background: {{ bg }};{%- endif -%}
    padding-top: var(--dose-pt);
    padding-bottom: var(--dose-pb);
  }
  #ElyteDose--{{ uid }} .elyte-dose__inner { max-width: 1040px; margin: 0 auto; padding: 0 20px; }
  #ElyteDose--{{ uid }} .elyte-dose__head { text-align: center; margin-bottom: 40px; }
  #ElyteDose--{{ uid }} .elyte-dose__eyebrow { font-size: 13px; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; color: var(--dose-accent); opacity: .7; margin: 0 0 10px; }
  #ElyteDose--{{ uid }} .elyte-dose__title { font-size: clamp(28px, 4.4vw, 44px); line-height: 1.08; margin: 0 0 14px; color: var(--dose-accent); }
  #ElyteDose--{{ uid }} .elyte-dose__sub { font-size: 17px; line-height: 1.6; max-width: 660px; margin: 0 auto; opacity: .82; }
  #ElyteDose--{{ uid }} .elyte-dose__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  #ElyteDose--{{ uid }} .elyte-dose__card {
    position: relative;
    border: 1px solid rgba(10,34,64,.12);
    border-radius: 18px;
    background: #fff;
    padding: 30px 24px 28px;
    text-align: center;
    box-shadow: 0 14px 44px -22px rgba(10,34,64,.4);
    transition: transform .25s ease;
  }
  #ElyteDose--{{ uid }} .elyte-dose__card:hover { transform: translateY(-4px); }
  #ElyteDose--{{ uid }} .elyte-dose__sticks { display: flex; align-items: flex-end; justify-content: center; gap: 6px; height: 56px; margin-bottom: 18px; }
  #ElyteDose--{{ uid }} .elyte-dose__stick { width: 16px; border-radius: 6px; background: var(--dose-accent); }
  #ElyteDose--{{ uid }} .elyte-dose__stick--ghost { background: rgba(10,34,64,.12); }
  #ElyteDose--{{ uid }} .elyte-dose__count { font-size: 15px; font-weight: 700; color: var(--dose-accent); margin: 0 0 4px; }
  #ElyteDose--{{ uid }} .elyte-dose__label { font-size: 20px; font-weight: 700; margin: 0 0 8px; color: var(--dose-accent); }
  #ElyteDose--{{ uid }} .elyte-dose__text { font-size: 15px; line-height: 1.5; margin: 0; opacity: .8; }
  #ElyteDose--{{ uid }} .elyte-dose__foot { text-align: center; margin-top: 28px; font-size: 14px; opacity: .7; }
  @media (max-width: 720px) {
    #ElyteDose--{{ uid }} .elyte-dose__grid { grid-template-columns: 1fr; gap: 14px; }
    #ElyteDose--{{ uid }} .elyte-dose__card { padding: 24px 20px; }
    #ElyteDose--{{ uid }} .elyte-dose__sticks { height: 44px; }
  }
{%- endstyle -%}

<section id="ElyteDose--{{ uid }}" class="shopdev shopdev-electrolyte-dosing" data-section-id="{{ uid }}" data-section-type="electrolyte-dosing">
  <div class="elyte-dose__inner">
    <div class="elyte-dose__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="elyte-dose__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="elyte-dose__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="elyte-dose__sub">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    <div class="elyte-dose__grid">
      {%- for block in section.blocks -%}
        {%- assign sticks = block.settings.sticks | default: 1 -%}
        <div class="elyte-dose__card" {{ block.shopify_attributes }}>
          <div class="elyte-dose__sticks" aria-hidden="true">
            {%- for i in (1..3) -%}
              {%- assign h = 0 -%}
              {%- if i == 1 -%}{%- assign h = 34 -%}{%- elsif i == 2 -%}{%- assign h = 46 -%}{%- else -%}{%- assign h = 56 -%}{%- endif -%}
              {%- if i <= sticks -%}
                <span class="elyte-dose__stick" style="height: {{ h }}px;"></span>
              {%- else -%}
                <span class="elyte-dose__stick elyte-dose__stick--ghost" style="height: {{ h }}px;"></span>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if block.settings.count_label != blank -%}
            <p class="elyte-dose__count">{{ block.settings.count_label }}</p>
          {%- endif -%}
          {%- if block.settings.label != blank -%}
            <p class="elyte-dose__label">{{ block.settings.label }}</p>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="elyte-dose__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="elyte-dose__foot">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Electrolyte Dosing",
  "class": "shopdev shopdev-electrolyte-dosing",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Scalable hydration" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for marathons. And Mondays." },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Most electrolytes give you one heavy dose built for hard sweating. BKM scales to your day — so you get exactly what you need, and never more sodium than your body can use.</p>" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Body size and conditions vary — listen to your body and adjust." },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#0A2240" },
    { "type": "color", "id": "bg_color", "label": "Section background" },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [
    {
      "type": "dose",
      "name": "Dose level",
      "settings": [
        { "type": "range", "id": "sticks", "min": 1, "max": 3, "step": 1, "label": "Number of sticks", "default": 1 },
        { "type": "text", "id": "count_label", "label": "Count label", "default": "1 stick / day" },
        { "type": "text", "id": "label", "label": "Title", "default": "Everyday" },
        { "type": "text", "id": "text", "label": "Description", "default": "A normal day, light sweat. Daily minerals and clean hydration without overloading your system." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Electrolyte Dosing",
      "blocks": [
        { "type": "dose", "settings": { "sticks": 1, "count_label": "1 stick / day", "label": "Everyday", "text": "A normal day, light sweat. Daily minerals and clean hydration without overloading your system." } },
        { "type": "dose", "settings": { "sticks": 2, "count_label": "2 sticks / day", "label": "Training", "text": "Regular training, real sweat. Step up minerals to match the effort and recover faster." } },
        { "type": "dose", "settings": { "sticks": 3, "count_label": "up to 3 / day", "label": "Hardest sessions", "text": "Long, hot, all-out — think Ironman. Maximum mineral replacement for the biggest days." } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  }
}
{% endschema %}
