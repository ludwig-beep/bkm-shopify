{% comment %}
  shopdev-electrolyte-dosing
  Signature "scales with your effort" module for the BKM Electrolytes PDP.
  Split layout: all copy on the left (dose levels stacked as a connected list),
  one large image on the right (Puresport-style). Self-contained, no external deps.
  Brand: BKM Blue (#0A2240), inherits theme body font (Avenir).
{% endcomment %}

{%- liquid
  assign accent = section.settings.accent_color | default: '#0A2240'
  assign bg = section.settings.bg_color
  assign uid = section.id
  assign img_right = section.settings.image_position | default: 'right'
-%}

{%- style -%}
  #ElyteDose--{{ uid }} {
    --dose-accent: {{ accent }};
    {%- if bg != blank and bg != 'rgba(0,0,0,0)' -%}background: {{ bg }};{%- endif -%}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #ElyteDose--{{ uid }} .elyte-dose__inner { max-width: 1180px; margin: 0 auto; padding: 0 20px; }
  #ElyteDose--{{ uid }} .elyte-dose__split {
    display: grid; grid-template-columns: 1fr 1fr; align-items: stretch; gap: 0;
    border-radius: 22px; overflow: hidden; background: #fff;
    box-shadow: 0 24px 70px -34px rgba(10,34,64,.45);
  }
  #ElyteDose--{{ uid }} .elyte-dose__copy { padding: clamp(28px, 4vw, 56px); display: flex; flex-direction: column; justify-content: center; {% if img_right == 'left' %}order: 2;{% endif %} }
  #ElyteDose--{{ uid }} .elyte-dose__eyebrow { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; font-weight: 700; color: var(--dose-accent); opacity: .65; margin: 0 0 14px; }
  #ElyteDose--{{ uid }} .elyte-dose__title { font-size: clamp(26px, 3.2vw, 40px); line-height: 1.08; margin: 0 0 14px; color: var(--dose-accent); }
  #ElyteDose--{{ uid }} .elyte-dose__sub { font-size: 16px; line-height: 1.6; margin: 0 0 30px; opacity: .8; }
  #ElyteDose--{{ uid }} .elyte-dose__list { position: relative; margin: 0; padding: 0; list-style: none; }
  #ElyteDose--{{ uid }} .elyte-dose__list::before {
    content: ''; position: absolute; left: 9px; top: 8px; bottom: 8px; width: 2px;
    background: linear-gradient(var(--dose-accent), rgba(10,34,64,.12));
  }
  #ElyteDose--{{ uid }} .elyte-dose__item { position: relative; padding: 0 0 26px 42px; }
  #ElyteDose--{{ uid }} .elyte-dose__item:last-child { padding-bottom: 0; }
  #ElyteDose--{{ uid }} .elyte-dose__dot {
    position: absolute; left: 0; top: 2px; width: 20px; height: 20px; border-radius: 50%;
    background: #fff; border: 2px solid var(--dose-accent); display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 800; color: var(--dose-accent);
  }
  #ElyteDose--{{ uid }} .elyte-dose__count { font-size: 13px; font-weight: 700; letter-spacing: .03em; color: var(--dose-accent); opacity: .65; margin: 0 0 3px; text-transform: uppercase; }
  #ElyteDose--{{ uid }} .elyte-dose__label { font-size: 19px; font-weight: 700; margin: 0 0 5px; color: var(--dose-accent); line-height: 1.2; }
  #ElyteDose--{{ uid }} .elyte-dose__text { font-size: 15px; line-height: 1.55; margin: 0; opacity: .78; }
  #ElyteDose--{{ uid }} .elyte-dose__foot { margin: 28px 0 0; font-size: 13px; opacity: .6; }
  #ElyteDose--{{ uid }} .elyte-dose__media { position: relative; min-height: 100%; background: rgba(10,34,64,.06); {% if img_right == 'left' %}order: 1;{% endif %} }
  #ElyteDose--{{ uid }} .elyte-dose__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #ElyteDose--{{ uid }} .elyte-dose__media-ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: var(--dose-accent); opacity: .4; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; }
  @media (max-width: 820px) {
    #ElyteDose--{{ uid }} .elyte-dose__split { grid-template-columns: 1fr; }
    #ElyteDose--{{ uid }} .elyte-dose__copy { order: 2; }
    #ElyteDose--{{ uid }} .elyte-dose__media { order: 1; min-height: 280px; }
  }
{%- endstyle -%}

<section id="ElyteDose--{{ uid }}" class="shopdev shopdev-electrolyte-dosing" data-section-id="{{ uid }}" data-section-type="electrolyte-dosing">
  <div class="elyte-dose__inner">
    <div class="elyte-dose__split">
      <div class="elyte-dose__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="elyte-dose__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="elyte-dose__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="elyte-dose__sub">{{ section.settings.subheading }}</div>
        {%- endif -%}

        <ul class="elyte-dose__list">
          {%- for block in section.blocks -%}
            {%- assign sticks = block.settings.sticks | default: 1 -%}
            <li class="elyte-dose__item" {{ block.shopify_attributes }}>
              <span class="elyte-dose__dot" aria-hidden="true">{{ sticks }}</span>
              {%- if block.settings.count_label != blank -%}
                <p class="elyte-dose__count">{{ block.settings.count_label }}</p>
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <p class="elyte-dose__label">{{ block.settings.label }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="elyte-dose__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if section.settings.footnote != blank -%}
          <p class="elyte-dose__foot">{{ section.settings.footnote }}</p>
        {%- endif -%}
      </div>

      <div class="elyte-dose__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(max-width: 820px) 100vw, 50vw', widths: '600, 900, 1200, 1400' }}
        {%- elsif section.settings.image_asset != blank -%}
          <img src="{{ section.settings.image_asset | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
        {%- elsif product.handle == 'bkm-electrolytes' -%}
          <img src="{{ 'elyte-dosing-lifestyle.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
        {%- else -%}
          <div class="elyte-dose__media-ph">Add image →</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Electrolyte Dosing",
  "class": "shopdev shopdev-electrolyte-dosing",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Scalable hydration" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for marathons. And Mondays." },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Most electrolytes give you one heavy dose built for hard sweating. BKM scales to your day — so you get exactly what you need, and never more sodium than your body can use.</p>" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Body size and conditions vary — listen to your body and adjust." },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image (right side)" },
    { "type": "text", "id": "image_asset", "label": "Image asset fallback (theme asset filename)", "info": "Used if no image is picked above. e.g. elyte-dosing-lifestyle.jpg" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [ { "value": "right", "label": "Right" }, { "value": "left", "label": "Left" } ], "default": "right" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#0A2240" },
    { "type": "color", "id": "bg_color", "label": "Section background" },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [
    {
      "type": "dose",
      "name": "Dose level",
      "settings": [
        { "type": "range", "id": "sticks", "min": 1, "max": 3, "step": 1, "label": "Number of scoops", "default": 1 },
        { "type": "text", "id": "count_label", "label": "Count label", "default": "1 scoop / day" },
        { "type": "text", "id": "label", "label": "Title", "default": "Everyday" },
        { "type": "text", "id": "text", "label": "Description", "default": "A normal day, light sweat — daily minerals without overloading." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Electrolyte Dosing",
      "blocks": [
        { "type": "dose", "settings": { "sticks": 1, "count_label": "1 scoop / day", "label": "Everyday", "text": "A normal day, light sweat — daily minerals without overloading." } },
        { "type": "dose", "settings": { "sticks": 2, "count_label": "2 scoops / day", "label": "Training", "text": "Real training, real sweat — step it up to match the effort." } },
        { "type": "dose", "settings": { "sticks": 3, "count_label": "up to 3 / day", "label": "Hardest sessions", "text": "Long, hot, all-out — maximum replacement for the biggest days." } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  }
}
{% endschema %}
