{% comment %}
  shopdev-video-grid
  Ambassador / UGC video wall for the BKM Electrolytes PDP (Puresport "Don't just take our word" style).
  Self-contained. Brand: BKM Blue (#0A2240), inherits theme body font (Avenir).
  Each block = a vertical video card: Shopify-hosted video (optional) + poster image (optional) +
  name + caption. Click a poster to play inline. Renders a graceful BKM-blue placeholder tile when
  no media is set yet, so the section reads as "videos coming" rather than broken.
{% endcomment %}

{%- liquid
  assign accent = section.settings.accent_color | default: '#0A2240'
  assign bg = section.settings.bg_color
  assign uid = section.id
-%}

{%- style -%}
  #ElyteVid--{{ uid }} {
    --vg-accent: {{ accent }};
    {%- if bg != blank and bg != 'rgba(0,0,0,0)' -%}background: {{ bg }};{%- endif -%}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #ElyteVid--{{ uid }} .vg__inner { max-width: 1280px; margin: 0 auto; padding: 0 20px; }
  #ElyteVid--{{ uid }} .vg__head { margin-bottom: 28px; max-width: 760px; }
  #ElyteVid--{{ uid }} .vg__title { font-size: clamp(28px, 4.4vw, 44px); line-height: 1.08; margin: 0 0 12px; color: var(--vg-accent); }
  #ElyteVid--{{ uid }} .vg__sub { font-size: 17px; line-height: 1.6; margin: 0; opacity: .82; }
  #ElyteVid--{{ uid }} .vg__scroller { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(220px, 1fr); gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; -webkit-overflow-scrolling: touch; }
  #ElyteVid--{{ uid }} .vg__card { scroll-snap-align: start; }
  #ElyteVid--{{ uid }} .vg__media { position: relative; aspect-ratio: 9 / 16; border-radius: 16px; overflow: hidden; background: linear-gradient(160deg, #0A2240, #1d3a5f); }
  #ElyteVid--{{ uid }} .vg__media img, #ElyteVid--{{ uid }} .vg__media video { width: 100%; height: 100%; object-fit: cover; display: block; }
  #ElyteVid--{{ uid }} .vg__play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; border: 0; background: transparent; cursor: pointer; }
  #ElyteVid--{{ uid }} .vg__play svg { width: 56px; height: 56px; filter: drop-shadow(0 2px 10px rgba(0,0,0,.35)); }
  #ElyteVid--{{ uid }} .vg__cap { position: absolute; left: 12px; right: 12px; bottom: 12px; color: #fff; font-size: 14px; font-weight: 600; line-height: 1.3; text-shadow: 0 1px 6px rgba(0,0,0,.5); }
  #ElyteVid--{{ uid }} .vg__name { margin-top: 10px; font-size: 14px; font-weight: 600; color: var(--vg-accent); }
  #ElyteVid--{{ uid }} .vg__scroller::-webkit-scrollbar { height: 6px; }
  #ElyteVid--{{ uid }} .vg__scroller::-webkit-scrollbar-thumb { background: rgba(10,34,64,.2); border-radius: 3px; }
{%- endstyle -%}

{%- capture play_icon -%}<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="11" fill="rgba(255,255,255,.92)"/><path d="M10 8.5l6 3.5-6 3.5v-7z" fill="#0A2240"/></svg>{%- endcapture -%}

<section id="ElyteVid--{{ uid }}" class="shopdev shopdev-video-grid" data-section-id="{{ uid }}">
  <div class="vg__inner">
    <div class="vg__head">
      {%- if section.settings.heading != blank -%}<h2 class="vg__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<div class="vg__sub">{{ section.settings.subheading }}</div>{%- endif -%}
    </div>
    <div class="vg__scroller">
      {%- for block in section.blocks -%}
        <div class="vg__card" {{ block.shopify_attributes }}>
          <div class="vg__media" data-vid-card>
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: image_size: '400x', controls: true, preload: 'none' }}
            {%- else -%}
              {%- if block.settings.poster != blank -%}
                {{ block.settings.poster | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.name }}
              {%- endif -%}
              <span class="vg__play" aria-hidden="true">{{ play_icon }}</span>
              {%- if block.settings.caption != blank -%}<span class="vg__cap">{{ block.settings.caption }}</span>{%- endif -%}
            {%- endif -%}
          </div>
          {%- if block.settings.name != blank -%}<div class="vg__name">{{ block.settings.name }}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video Grid",
  "class": "shopdev shopdev-video-grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made by athletes. For everyone." },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>From race day to the morning after — real people on why BKM is part of their day.</p>" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#0A2240" },
    { "type": "color", "id": "bg_color", "label": "Section background" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [
    {
      "type": "clip",
      "name": "Video clip",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (Shopify-hosted)" },
        { "type": "image_picker", "id": "poster", "label": "Poster image (shown before play / if no video)" },
        { "type": "text", "id": "caption", "label": "Overlay caption", "default": "" },
        { "type": "text", "id": "name", "label": "Name / handle", "default": "" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Video Grid",
      "blocks": [
        { "type": "clip", "settings": { "caption": "“I drink it every single day.”", "name": "Add ambassador" } },
        { "type": "clip", "settings": { "caption": "“The morning after, this is what I reach for.”", "name": "Add ambassador" } },
        { "type": "clip", "settings": { "caption": "“Finally an electrolyte I can take daily.”", "name": "Add ambassador" } },
        { "type": "clip", "settings": { "caption": "“Race day essential.”", "name": "Add ambassador" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "aside", "footer"] }
}
{% endschema %}
