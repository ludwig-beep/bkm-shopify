{% comment %}
  shopdev-electrolyte-comparison
  Bespoke "Not a sports drink" comparison table for the BKM Electrolytes PDP.
  Self-contained (no external deps). Brand: BKM Blue (#0A2240), inherits theme body font (Avenir).
  Each row is a block: feature label + whether BKM / "ordinary" electrolytes have it.
{% endcomment %}

{%- liquid
  assign accent = section.settings.accent_color | default: '#0A2240'
  assign bg = section.settings.bg_color
  assign uid = section.id
-%}

{%- style -%}
  #ElyteCompare--{{ uid }} {
    --elyte-accent: {{ accent }};
    --elyte-pt: {{ section.settings.padding_top }}px;
    --elyte-pb: {{ section.settings.padding_bottom }}px;
    {%- if bg != blank and bg != 'rgba(0,0,0,0)' -%}background: {{ bg }};{%- endif -%}
    padding-top: var(--elyte-pt);
    padding-bottom: var(--elyte-pb);
  }
  #ElyteCompare--{{ uid }} .elyte-compare__inner { max-width: 880px; margin: 0 auto; padding: 0 20px; }
  #ElyteCompare--{{ uid }} .elyte-compare__head { text-align: center; margin-bottom: 32px; }
  #ElyteCompare--{{ uid }} .elyte-compare__title { font-size: clamp(26px, 4vw, 40px); line-height: 1.1; margin: 0 0 12px; }
  #ElyteCompare--{{ uid }} .elyte-compare__sub { font-size: 16px; line-height: 1.55; max-width: 620px; margin: 0 auto; opacity: .8; }
  #ElyteCompare--{{ uid }} .elyte-compare__table {
    border: 1px solid rgba(10,34,64,.12);
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 10px 40px -18px rgba(10,34,64,.35);
  }
  #ElyteCompare--{{ uid }} .elyte-compare__row {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    align-items: center;
  }
  #ElyteCompare--{{ uid }} .elyte-compare__row + .elyte-compare__row { border-top: 1px solid rgba(10,34,64,.08); }
  #ElyteCompare--{{ uid }} .elyte-compare__cell { padding: 18px 16px; font-size: 15px; line-height: 1.4; text-align: center; }
  #ElyteCompare--{{ uid }} .elyte-compare__cell--feature { text-align: left; font-weight: 600; color: var(--elyte-accent); }
  #ElyteCompare--{{ uid }} .elyte-compare__cell--bkm { background: rgba(10,34,64,.04); }
  #ElyteCompare--{{ uid }} .elyte-compare__head-row { background: var(--elyte-accent); color: #fff; }
  #ElyteCompare--{{ uid }} .elyte-compare__head-row .elyte-compare__cell { font-weight: 700; font-size: 15px; }
  #ElyteCompare--{{ uid }} .elyte-compare__head-row .elyte-compare__cell--feature { color: #fff; }
  #ElyteCompare--{{ uid }} .elyte-compare__head-row .elyte-compare__cell--bkm { background: rgba(255,255,255,.08); }
  #ElyteCompare--{{ uid }} .elyte-compare__mark { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; }
  #ElyteCompare--{{ uid }} .elyte-compare__mark--yes { background: var(--elyte-accent); color: #fff; }
  #ElyteCompare--{{ uid }} .elyte-compare__mark--no { background: rgba(10,34,64,.06); color: rgba(10,34,64,.4); }
  #ElyteCompare--{{ uid }} .elyte-compare__mark svg { width: 14px; height: 14px; }
  #ElyteCompare--{{ uid }} .elyte-compare__note { display: block; font-size: 12px; opacity: .65; margin-top: 4px; font-weight: 400; }
  @media (max-width: 600px) {
    #ElyteCompare--{{ uid }} .elyte-compare__row { grid-template-columns: 1.2fr .9fr .9fr; }
    #ElyteCompare--{{ uid }} .elyte-compare__cell { padding: 14px 8px; font-size: 13px; }
    #ElyteCompare--{{ uid }} .elyte-compare__head-row .elyte-compare__cell { font-size: 12px; }
  }
{%- endstyle -%}

<section id="ElyteCompare--{{ uid }}" class="shopdev shopdev-electrolyte-comparison" data-section-id="{{ uid }}" data-section-type="electrolyte-comparison">
  <div class="elyte-compare__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="elyte-compare__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="elyte-compare__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="elyte-compare__sub">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="elyte-compare__table" role="table">
      <div class="elyte-compare__row elyte-compare__head-row" role="row">
        <div class="elyte-compare__cell elyte-compare__cell--feature" role="columnheader">{{ section.settings.feature_col_label }}</div>
        <div class="elyte-compare__cell elyte-compare__cell--bkm" role="columnheader">{{ section.settings.bkm_col_label }}</div>
        <div class="elyte-compare__cell elyte-compare__cell--other" role="columnheader">{{ section.settings.other_col_label }}</div>
      </div>

      {%- for block in section.blocks -%}
        <div class="elyte-compare__row" role="row" {{ block.shopify_attributes }}>
          <div class="elyte-compare__cell elyte-compare__cell--feature" role="cell">
            {{ block.settings.feature_label }}
            {%- if block.settings.feature_note != blank -%}<span class="elyte-compare__note">{{ block.settings.feature_note }}</span>{%- endif -%}
          </div>
          <div class="elyte-compare__cell elyte-compare__cell--bkm" role="cell">
            {%- if block.settings.bkm_has -%}
              <span class="elyte-compare__mark elyte-compare__mark--yes" aria-label="Ja">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            {%- else -%}
              <span class="elyte-compare__mark elyte-compare__mark--no" aria-label="Nej">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
              </span>
            {%- endif -%}
          </div>
          <div class="elyte-compare__cell elyte-compare__cell--other" role="cell">
            {%- if block.settings.other_has -%}
              <span class="elyte-compare__mark elyte-compare__mark--yes" aria-label="Ja">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            {%- else -%}
              <span class="elyte-compare__mark elyte-compare__mark--no" aria-label="Nej">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
              </span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Electrolyte Comparison",
  "class": "shopdev shopdev-electrolyte-comparison",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not just a sports drink. An everyday electrolyte."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Most electrolytes are built for heavy sweating and overload you with sodium on an ordinary day. BKM is calibrated for daily use — and scales up when you train hard.</p>"
    },
    {
      "type": "header",
      "content": "Column labels"
    },
    {
      "type": "text",
      "id": "feature_col_label",
      "label": "Feature column label"
    },
    {
      "type": "text",
      "id": "bkm_col_label",
      "label": "BKM column label",
      "default": "BKM Electrolytes"
    },
    {
      "type": "text",
      "id": "other_col_label",
      "label": "Other column label",
      "default": "Ordinary electrolytes"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#0A2240"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "feature_label",
          "label": "Feature",
          "default": "Feature"
        },
        {
          "type": "text",
          "id": "feature_note",
          "label": "Feature note (optional)"
        },
        {
          "type": "checkbox",
          "id": "bkm_has",
          "label": "BKM has this",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "other_has",
          "label": "Ordinary electrolytes have this",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Electrolyte Comparison",
      "blocks": [
        { "type": "row", "settings": { "feature_label": "Calibrated for daily use", "feature_note": "lower sodium so you can drink it every day without overloading", "bkm_has": true, "other_has": false } },
        { "type": "row", "settings": { "feature_label": "Scales with your effort", "feature_note": "1 stick everyday · 2 when you train · up to 3 for the hardest sessions", "bkm_has": true, "other_has": false } },
        { "type": "row", "settings": { "feature_label": "NAC to support liver & kidneys", "feature_note": "rarely found in any electrolyte", "bkm_has": true, "other_has": false } },
        { "type": "row", "settings": { "feature_label": "Guérande sea salt + coconut water powder", "feature_note": "full trace-mineral profile, not refined salt", "bkm_has": true, "other_has": false } },
        { "type": "row", "settings": { "feature_label": "Prebiotic + probiotic gut layer", "feature_note": "Inulin + LactoSpore® for real absorption", "bkm_has": true, "other_has": false } },
        { "type": "row", "settings": { "feature_label": "Acerola Vitamin C, Vitamin D3 & selenium", "feature_note": "antioxidant, immune & thyroid support", "bkm_has": true, "other_has": false } },
        { "type": "row", "settings": { "feature_label": "No added sugar", "feature_note": "naturally sweetened with stevia", "bkm_has": true, "other_has": false } },
        { "type": "row", "settings": { "feature_label": "Replaces minerals lost in sweat", "bkm_has": true, "other_has": true } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  }
}
{% endschema %}
