{% comment %}
  shopdev-electrolyte-comparison
  "Us vs Them" multi-column comparison for the BKM Electrolytes PDP.
  Self-contained. Brand: BKM Blue (#0A2240), inherits theme body font (Avenir).
  Up to 4 columns: BKM + 3 alternatives (ordinary electrolytes / tablets / sports drinks).
  Each row block sets a state per column: yes (filled) / partial (half) / no (empty).
{% endcomment %}

{%- liquid
  assign accent = section.settings.accent_color | default: '#0A2240'
  assign bg = section.settings.bg_color
  assign uid = section.id
  assign show3 = section.settings.show_col3
  assign show4 = section.settings.show_col4
  assign cols = 1
  if show3
    assign cols = cols | plus: 1
  endif
  if show4
    assign cols = cols | plus: 1
  endif
-%}

{%- style -%}
  #ElyteCompare--{{ uid }} {
    --elyte-accent: {{ accent }};
    --elyte-pt: {{ section.settings.padding_top }}px;
    --elyte-pb: {{ section.settings.padding_bottom }}px;
    {%- if bg != blank and bg != 'rgba(0,0,0,0)' -%}background: {{ bg }};{%- endif -%}
    padding-top: var(--elyte-pt);
    padding-bottom: var(--elyte-pb);
  }
  #ElyteCompare--{{ uid }} .elyte-compare__inner { max-width: 1040px; margin: 0 auto; padding: 0 20px; }
  #ElyteCompare--{{ uid }} .elyte-compare__head { margin-bottom: 28px; }
  #ElyteCompare--{{ uid }} .elyte-compare__title { font-size: clamp(26px, 4vw, 40px); line-height: 1.1; margin: 0 0 12px; color: var(--elyte-accent); }
  #ElyteCompare--{{ uid }} .elyte-compare__sub { font-size: 16px; line-height: 1.55; max-width: 620px; margin: 0; opacity: .8; }
  #ElyteCompare--{{ uid }} .elyte-compare__table { width: 100%; }
  #ElyteCompare--{{ uid }} .elyte-compare__row {
    display: grid;
    grid-template-columns: 1.7fr repeat({{ cols }}, 1fr);
    align-items: center;
    border-top: 1px solid rgba(10,34,64,.12);
  }
  #ElyteCompare--{{ uid }} .elyte-compare__row:last-child { border-bottom: 1px solid rgba(10,34,64,.12); }
  #ElyteCompare--{{ uid }} .elyte-compare__cell { padding: 18px 10px; font-size: 15px; line-height: 1.4; text-align: center; }
  #ElyteCompare--{{ uid }} .elyte-compare__cell--feature { text-align: left; font-weight: 600; color: var(--elyte-accent); padding-left: 0; }
  #ElyteCompare--{{ uid }} .elyte-compare__cell--bkm { background: rgba(10,34,64,.04); }
  #ElyteCompare--{{ uid }} .elyte-compare__head-row { border-top: 0; }
  #ElyteCompare--{{ uid }} .elyte-compare__head-row .elyte-compare__cell { font-weight: 700; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: var(--elyte-accent); }
  #ElyteCompare--{{ uid }} .elyte-compare__head-row .elyte-compare__cell--bkm { border-radius: 12px 12px 0 0; }
  #ElyteCompare--{{ uid }} .elyte-compare__row:last-child .elyte-compare__cell--bkm { border-radius: 0 0 12px 12px; }
  #ElyteCompare--{{ uid }} .elyte-compare__dot { display: inline-block; width: 20px; height: 20px; border-radius: 50%; vertical-align: middle; }
  #ElyteCompare--{{ uid }} .elyte-compare__dot--yes { background: var(--elyte-accent); }
  #ElyteCompare--{{ uid }} .elyte-compare__dot--no { background: transparent; box-shadow: inset 0 0 0 1.5px rgba(10,34,64,.3); }
  #ElyteCompare--{{ uid }} .elyte-compare__dot--partial { background: linear-gradient(90deg, var(--elyte-accent) 50%, transparent 50%); box-shadow: inset 0 0 0 1.5px rgba(10,34,64,.3); }
  #ElyteCompare--{{ uid }} .elyte-compare__note { display: block; font-size: 12px; opacity: .6; margin-top: 4px; font-weight: 400; }
  @media (max-width: 640px) {
    #ElyteCompare--{{ uid }} .elyte-compare__cell { padding: 14px 4px; font-size: 12px; }
    #ElyteCompare--{{ uid }} .elyte-compare__head-row .elyte-compare__cell { font-size: 10px; }
    #ElyteCompare--{{ uid }} .elyte-compare__dot { width: 16px; height: 16px; }
  }
{%- endstyle -%}

{%- capture dot_yes -%}<span class="elyte-compare__dot elyte-compare__dot--yes" aria-label="Yes"></span>{%- endcapture -%}
{%- capture dot_no -%}<span class="elyte-compare__dot elyte-compare__dot--no" aria-label="No"></span>{%- endcapture -%}
{%- capture dot_partial -%}<span class="elyte-compare__dot elyte-compare__dot--partial" aria-label="Partial"></span>{%- endcapture -%}

<section id="ElyteCompare--{{ uid }}" class="shopdev shopdev-electrolyte-comparison" data-section-id="{{ uid }}" data-section-type="electrolyte-comparison">
  <div class="elyte-compare__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="elyte-compare__head">
        {%- if section.settings.heading != blank -%}<h2 class="elyte-compare__title">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<div class="elyte-compare__sub">{{ section.settings.subheading }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="elyte-compare__table" role="table">
      <div class="elyte-compare__row elyte-compare__head-row" role="row">
        <div class="elyte-compare__cell elyte-compare__cell--feature" role="columnheader">{{ section.settings.feature_col_label }}</div>
        <div class="elyte-compare__cell elyte-compare__cell--bkm" role="columnheader">{{ section.settings.bkm_col_label }}</div>
        {%- if show3 -%}<div class="elyte-compare__cell" role="columnheader">{{ section.settings.col3_label }}</div>{%- endif -%}
        {%- if show4 -%}<div class="elyte-compare__cell" role="columnheader">{{ section.settings.col4_label }}</div>{%- endif -%}
        <div class="elyte-compare__cell" role="columnheader">{{ section.settings.col2_label }}</div>
      </div>

      {%- for block in section.blocks -%}
        <div class="elyte-compare__row" role="row" {{ block.shopify_attributes }}>
          <div class="elyte-compare__cell elyte-compare__cell--feature" role="cell">
            {{ block.settings.feature_label }}
            {%- if block.settings.feature_note != blank -%}<span class="elyte-compare__note">{{ block.settings.feature_note }}</span>{%- endif -%}
          </div>
          <div class="elyte-compare__cell elyte-compare__cell--bkm" role="cell">
            {%- case block.settings.bkm -%}{%- when 'yes' -%}{{ dot_yes }}{%- when 'partial' -%}{{ dot_partial }}{%- else -%}{{ dot_no }}{%- endcase -%}
          </div>
          {%- if show3 -%}<div class="elyte-compare__cell" role="cell">{%- case block.settings.col3 -%}{%- when 'yes' -%}{{ dot_yes }}{%- when 'partial' -%}{{ dot_partial }}{%- else -%}{{ dot_no }}{%- endcase -%}</div>{%- endif -%}
          {%- if show4 -%}<div class="elyte-compare__cell" role="cell">{%- case block.settings.col4 -%}{%- when 'yes' -%}{{ dot_yes }}{%- when 'partial' -%}{{ dot_partial }}{%- else -%}{{ dot_no }}{%- endcase -%}</div>{%- endif -%}
          <div class="elyte-compare__cell" role="cell">{%- case block.settings.col2 -%}{%- when 'yes' -%}{{ dot_yes }}{%- when 'partial' -%}{{ dot_partial }}{%- else -%}{{ dot_no }}{%- endcase -%}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Electrolyte Comparison",
  "class": "shopdev shopdev-electrolyte-comparison",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Us vs them. How we stack up." },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Most electrolytes are built for heavy sweating and overload you with sodium on an ordinary day. BKM is calibrated for daily use — and scales up when you train hard.</p>" },
    { "type": "header", "content": "Column labels" },
    { "type": "text", "id": "feature_col_label", "label": "Feature column label", "default": "What matters" },
    { "type": "text", "id": "bkm_col_label", "label": "BKM column label", "default": "BKM" },
    { "type": "text", "id": "col2_label", "label": "Column 2 label", "default": "Ordinary electrolytes" },
    { "type": "checkbox", "id": "show_col3", "label": "Show column 3", "default": true },
    { "type": "text", "id": "col3_label", "label": "Column 3 label", "default": "Tablets / sticks" },
    { "type": "checkbox", "id": "show_col4", "label": "Show column 4", "default": true },
    { "type": "text", "id": "col4_label", "label": "Column 4 label", "default": "Sports drinks" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#0A2240" },
    { "type": "color", "id": "bg_color", "label": "Section background" },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "feature_label", "label": "Feature", "default": "Feature" },
        { "type": "text", "id": "feature_note", "label": "Feature note (optional)" },
        { "type": "select", "id": "bkm", "label": "BKM", "default": "yes", "options": [ {"value":"yes","label":"Yes"}, {"value":"partial","label":"Partial"}, {"value":"no","label":"No"} ] },
        { "type": "select", "id": "col2", "label": "Ordinary electrolytes", "default": "no", "options": [ {"value":"yes","label":"Yes"}, {"value":"partial","label":"Partial"}, {"value":"no","label":"No"} ] },
        { "type": "select", "id": "col3", "label": "Tablets / sticks", "default": "no", "options": [ {"value":"yes","label":"Yes"}, {"value":"partial","label":"Partial"}, {"value":"no","label":"No"} ] },
        { "type": "select", "id": "col4", "label": "Sports drinks", "default": "no", "options": [ {"value":"yes","label":"Yes"}, {"value":"partial","label":"Partial"}, {"value":"no","label":"No"} ] }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Electrolyte Comparison",
      "blocks": [
        { "type": "row", "settings": { "feature_label": "Calibrated for daily use", "feature_note": "lower sodium, drink it every day", "bkm": "yes", "col2": "no", "col3": "no", "col4": "no" } },
        { "type": "row", "settings": { "feature_label": "Scales with your effort (1–3 sticks)", "bkm": "yes", "col2": "no", "col3": "partial", "col4": "no" } },
        { "type": "row", "settings": { "feature_label": "NAC to support liver & kidneys", "bkm": "yes", "col2": "no", "col3": "no", "col4": "no" } },
        { "type": "row", "settings": { "feature_label": "Prebiotic + probiotic gut layer", "bkm": "yes", "col2": "no", "col3": "no", "col4": "no" } },
        { "type": "row", "settings": { "feature_label": "Full-spectrum minerals (Guérande + coconut)", "bkm": "yes", "col2": "partial", "col3": "no", "col4": "no" } },
        { "type": "row", "settings": { "feature_label": "No added sugar", "bkm": "yes", "col2": "yes", "col3": "yes", "col4": "no" } },
        { "type": "row", "settings": { "feature_label": "Replaces minerals lost in sweat", "bkm": "yes", "col2": "yes", "col3": "yes", "col4": "partial" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "aside", "footer"] }
}
{% endschema %}
