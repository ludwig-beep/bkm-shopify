{% comment %}
  shopdev-sticky-shop-now-bar
  Mobile-first sticky add-to-cart bar for the BKM Electrolytes PDP.
  Self-contained: all layout lives in the scoped <style> block below — this theme does NOT
  ship Tailwind utilities, so the bar must not depend on them. Hides on scroll-down, shows on
  scroll-up. Tapping the CTA smooth-scrolls to the buy box.
{% endcomment %}

{%- liquid
  assign uid = section.id
  assign bg = section.settings.background_color | default: '#ffffff'
  assign border = section.settings.border_color | default: '#e5e5e5'
  assign text = section.settings.text_color | default: '#1a1a1a'
  assign btn_bg = section.settings.button_bg_color | default: '#0A2240'
  assign btn_text = section.settings.button_text_color | default: '#ffffff'
  assign font = section.settings.font_family | default: 'system-ui, -apple-system, sans-serif'
  assign prod = section.settings.product
-%}

{%- style -%}
  #StickyBar--{{ uid }} {
    --sb-bg: {{ bg }};
    --sb-border: {{ border }};
    --sb-text: {{ text }};
    --sb-btn-bg: {{ btn_bg }};
    --sb-btn-text: {{ btn_text }};
    --sb-font: {{ font }};
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 1000;
    background: var(--sb-bg);
    border-top: 1px solid var(--sb-border);
    box-shadow: 0 -4px 20px rgba(0,0,0,.1);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    transform: translateY(0); transition: transform .3s ease-in-out;
    padding: env(safe-area-inset-bottom, 0) 0 0;
    font-family: var(--sb-font); color: var(--sb-text);
  }
  #StickyBar--{{ uid }}.is-hidden { transform: translateY(110%); }
  #StickyBar--{{ uid }} .sb__inner { max-width: 1180px; margin: 0 auto; padding: 12px 16px; }
  #StickyBar--{{ uid }} .sb__row { display: flex; align-items: center; gap: 12px; }
  #StickyBar--{{ uid }} .sb__media { width: 46px; height: 46px; flex: 0 0 auto; border-radius: 8px; overflow: hidden; background: rgba(10,34,64,.08); }
  #StickyBar--{{ uid }} .sb__media img, #StickyBar--{{ uid }} .sb__media svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  #StickyBar--{{ uid }} .sb__info { flex: 1 1 auto; min-width: 0; }
  #StickyBar--{{ uid }} .sb__title { margin: 0; font-size: 15px; font-weight: 700; line-height: 1.2; color: var(--sb-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #StickyBar--{{ uid }} .sb__trust { margin: 2px 0 0; font-size: 12px; line-height: 1.3; opacity: .75; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #StickyBar--{{ uid }} .sb__cta {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    min-height: 46px; padding: 10px 24px; border: 0; border-radius: 10px;
    font-family: var(--sb-font); font-size: 15px; font-weight: 700; text-decoration: none; cursor: pointer;
    background: var(--sb-btn-bg); color: var(--sb-btn-text);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  #StickyBar--{{ uid }} .sb__cta:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(0,0,0,.18); }
  #StickyBar--{{ uid }} .sb__cta[disabled] { opacity: .5; cursor: not-allowed; }
  #StickyBar--{{ uid }} .sb__signals {
    display: flex; align-items: center; justify-content: center; flex-wrap: wrap;
    gap: 6px 18px; margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(0,0,0,.08);
  }
  #StickyBar--{{ uid }} .sb__signal { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; white-space: nowrap; opacity: .85; }
  #StickyBar--{{ uid }} .sb__signal img { width: 16px; height: 16px; object-fit: contain; flex: 0 0 auto; }

  @media (max-width: 600px) {
    #StickyBar--{{ uid }} .sb__inner { padding: 10px 12px; }
    #StickyBar--{{ uid }} .sb__row { gap: 10px; }
    #StickyBar--{{ uid }} .sb__media { width: 40px; height: 40px; }
    #StickyBar--{{ uid }} .sb__title { font-size: 14px; }
    #StickyBar--{{ uid }} .sb__trust { font-size: 11px; }
    #StickyBar--{{ uid }} .sb__cta { min-height: 44px; padding: 9px 18px; font-size: 14px; }
    /* Trust signals eat vertical space + wrap awkwardly on small screens — hide to keep the bar slim */
    #StickyBar--{{ uid }} .sb__signals { display: none; }
  }
  @media (min-width: 750px) {
    #StickyBar--{{ uid }} .sb__media { width: 56px; height: 56px; }
    #StickyBar--{{ uid }} .sb__title { font-size: 16px; }
    #StickyBar--{{ uid }} .sb__cta { padding: 11px 32px; font-size: 16px; }
  }
{%- endstyle -%}

<div id="StickyBar--{{ uid }}" class="shopdev shopdev-sticky-shop-now-bar sb is-hidden notranslate" data-section-id="{{ uid }}">
  <div class="sb__inner">
    <div class="sb__row">
      <div class="sb__media">
        {%- if prod != blank and prod.featured_image -%}
          {{ prod.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: prod.title }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="sb__info">
        <p class="sb__title">{{ prod.title | default: 'Select a product' }}</p>
        {%- if section.settings.trust_message != blank -%}
          <p class="sb__trust">{{ section.settings.trust_message }}</p>
        {%- endif -%}
      </div>

      {%- if prod != blank -%}
        <a href="{{ prod.url }}" class="sb__cta"
           onclick="var t=document.querySelector('.enhanced-variant-selector')||document.querySelector('.product-form')||document.querySelector('.product-single'); if(t){t.scrollIntoView({behavior:'smooth',block:'center'});return false;}">
          {{ section.settings.button_text | default: 'Shop Now' }}
        </a>
      {%- else -%}
        <button class="sb__cta" disabled>Select Product</button>
      {%- endif -%}
    </div>

    {%- if section.settings.show_trust_signals -%}
      <div class="sb__signals">
        {%- for i in (1..3) -%}
          {%- liquid
            assign label_key = 'trust_signal_' | append: i
            assign icon_key = 'trust_signal_' | append: i | append: '_icon'
            assign label = section.settings[label_key]
            assign icon = section.settings[icon_key]
          -%}
          {%- if label != blank -%}
            <span class="sb__signal">
              {%- if icon != blank -%}<img src="{{ icon | image_url: width: 32 }}" alt="{{ label }}" loading="lazy">{%- endif -%}
              <span>{{ label }}</span>
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var bar = document.getElementById('StickyBar--{{ uid }}');
    if (!bar) return;
    var lastY = window.scrollY, ticking = false;
    function update() {
      var y = window.scrollY;
      // Reveal once the user has scrolled past the hero; hide when scrolling down
      if (y > 400 && y <= lastY) { bar.classList.remove('is-hidden'); }
      else if (y > lastY || y <= 400) { bar.classList.add('is-hidden'); }
      lastY = y; ticking = false;
    }
    window.addEventListener('scroll', function () {
      if (!ticking) { requestAnimationFrame(update); ticking = true; }
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Sticky Shop Now Bar",
  "class": "shopdev shopdev-sticky-shop-now-bar",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Product Selection"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "header",
      "content": "Trust Messages"
    },
    {
      "type": "text",
      "id": "trust_message",
      "label": "Product Trust Message",
      "default": "Free shipping on orders over $50"
    },
    {
      "type": "checkbox",
      "id": "show_trust_signals",
      "label": "Show trust signals",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_signal_1",
      "label": "Trust Signal 1",
      "default": "Secure Checkout"
    },
    {
      "type": "text",
      "id": "trust_signal_2",
      "label": "Trust Signal 2",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "trust_signal_3",
      "label": "Trust Signal 3",
      "default": "30-Day Returns"
    },
    {
      "type": "image_picker",
      "id": "trust_signal_1_icon",
      "label": "Trust Signal 1 Icon",
      "info": "Upload a custom icon image for the first trust signal"
    },
    {
      "type": "image_picker",
      "id": "trust_signal_2_icon",
      "label": "Trust Signal 2 Icon",
      "info": "Upload a custom icon image for the second trust signal"
    },
    {
      "type": "image_picker",
      "id": "trust_signal_3_icon",
      "label": "Trust Signal 3 Icon",
      "info": "Upload a custom icon image for the third trust signal"
    },
    {
      "type": "header",
      "content": "Design & Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#0A2240"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#e5e5e5"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font Family",
      "options": [
        {
          "value": "system-ui, -apple-system, sans-serif",
          "label": "System Font"
        },
        {
          "value": "Georgia, serif",
          "label": "Georgia"
        },
        {
          "value": "Arial, sans-serif",
          "label": "Arial"
        },
        {
          "value": "'Helvetica Neue', sans-serif",
          "label": "Helvetica"
        }
      ],
      "default": "system-ui, -apple-system, sans-serif"
    }
  ],
  "presets": [
    {
      "name": "Sticky Shop Now Bar",
      "settings": {
        "button_text": "Shop Now",
        "trust_message": "Clinically tested • 30-day money-back guarantee",
        "show_trust_signals": true,
        "trust_signal_1": "Secure Checkout",
        "trust_signal_2": "Free Shipping $75+",
        "trust_signal_3": "30-Day Returns",
        "background_color": "#ffffff",
        "text_color": "#2c3e50",
        "button_bg_color": "#0A2240",
        "button_text_color": "#ffffff",
        "border_color": "#ecf0f1"
      }
    }
  ]
}
{% endschema %}
