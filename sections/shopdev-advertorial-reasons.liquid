{% comment %}
  shopdev-advertorial-reasons
  Long-form advertorial "X reasons" section for landing pages (Hears lp0-7reasons style).
  Editorial header (eyebrow + byline + "read this first" callout + headline + intro + rating),
  then numbered reason blocks in an alternating image | text two-column layout. Each reason:
  image (or branded placeholder) + number badge + title + body + optional customer pull-quote
  + optional inline CTA. Self-contained. Brand: BKM Blue (#0A2240), inherits Avenir.
{% endcomment %}

{%- liquid
  assign accent = section.settings.accent_color | default: '#0A2240'
  assign hl = section.settings.accent_2 | default: '#c1457f'
  assign bg = section.settings.bg_color | default: '#ffffff'
  assign uid = section.id
-%}

{%- style -%}
  #ElyteAdv--{{ uid }} { --adv-accent: {{ accent }}; --adv-hl: {{ hl }}; background: {{ bg }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  #ElyteAdv--{{ uid }} .adv__inner { max-width: 1040px; margin: 0 auto; padding: 0 20px; }
  #ElyteAdv--{{ uid }} .adv__hero { max-width: 760px; margin: 0 auto 40px; }
  #ElyteAdv--{{ uid }} .adv__eyebrow { font-size: 13px; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; color: var(--adv-accent); opacity: .65; margin: 0 0 14px; }
  #ElyteAdv--{{ uid }} .adv__title { font-size: clamp(30px, 5vw, 50px); line-height: 1.05; margin: 0 0 20px; color: var(--adv-accent); font-weight: 800; }
  #ElyteAdv--{{ uid }} .adv__title em { font-style: normal; color: var(--adv-hl); }
  #ElyteAdv--{{ uid }} .adv__byline { display: flex; align-items: center; gap: 12px; margin: 0 0 22px; }
  #ElyteAdv--{{ uid }} .adv__byline img, #ElyteAdv--{{ uid }} .adv__byline .adv__byph { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; flex: 0 0 auto; background: rgba(10,34,64,.1); }
  #ElyteAdv--{{ uid }} .adv__byname { font-size: 15px; color: var(--adv-accent); } #ElyteAdv--{{ uid }} .adv__byname strong { font-weight: 700; }
  #ElyteAdv--{{ uid }} .adv__bydate { font-size: 13px; opacity: .6; }
  #ElyteAdv--{{ uid }} .adv__callout { background: #fdf6ec; border-radius: 12px; padding: 16px 20px; font-size: 18px; font-weight: 700; color: var(--adv-accent); margin: 0 0 22px; }
  #ElyteAdv--{{ uid }} .adv__intro { font-size: 18px; line-height: 1.65; opacity: .85; margin: 0; }
  #ElyteAdv--{{ uid }} .adv__rating { display: inline-flex; align-items: center; gap: 8px; margin-top: 18px; font-size: 14px; font-weight: 600; color: var(--adv-accent); }
  #ElyteAdv--{{ uid }} .adv__rating .adv__stars { color: var(--adv-hl); letter-spacing: 1px; }

  #ElyteAdv--{{ uid }} .adv__reason { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; padding: 36px 0; }
  #ElyteAdv--{{ uid }} .adv__media { border-radius: 18px; overflow: hidden; aspect-ratio: 4/3; background: linear-gradient(150deg, var(--adv-accent), var(--adv-hl)); display: flex; align-items: center; justify-content: center; }
  #ElyteAdv--{{ uid }} .adv__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #ElyteAdv--{{ uid }} .adv__reason:last-of-type .adv__media { aspect-ratio: 3 / 4; }
  #ElyteAdv--{{ uid }} .adv__media-ph { color: rgba(255,255,255,.5); font-size: 13px; letter-spacing: .08em; text-transform: uppercase; }
  #ElyteAdv--{{ uid }} .adv__num { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: var(--adv-accent); color: #fff; font-weight: 800; font-size: 15px; margin-bottom: 14px; }
  #ElyteAdv--{{ uid }} .adv__rtitle { font-size: clamp(22px, 2.6vw, 30px); line-height: 1.15; margin: 0 0 14px; color: var(--adv-accent); font-weight: 800; }
  #ElyteAdv--{{ uid }} .adv__body { font-size: 17px; line-height: 1.6; opacity: .85; margin: 0 0 16px; }
  #ElyteAdv--{{ uid }} .adv__quote { border-left: 3px solid var(--adv-hl); padding: 4px 0 4px 16px; margin: 0 0 16px; }
  #ElyteAdv--{{ uid }} .adv__quote p { font-size: 16px; line-height: 1.5; font-style: italic; margin: 0 0 6px; color: var(--adv-accent); }
  #ElyteAdv--{{ uid }} .adv__quote cite { font-size: 13px; font-style: normal; font-weight: 600; opacity: .6; }
  #ElyteAdv--{{ uid }} .adv__cta { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 12px 28px; border-radius: 999px; background: var(--adv-accent); color: #fff; font-weight: 700; font-size: 15px; text-decoration: none; transition: transform .15s; }
  #ElyteAdv--{{ uid }} .adv__cta:hover { transform: translateY(-1px); }
  @media (max-width: 760px) {
    #ElyteAdv--{{ uid }} .adv__reason { grid-template-columns: 1fr; gap: 18px; padding: 28px 0; }
    #ElyteAdv--{{ uid }} .adv__body { font-size: 16px; }
    #ElyteAdv--{{ uid }} .adv__callout { font-size: 16px; }
  }
{%- endstyle -%}

<section id="ElyteAdv--{{ uid }}" class="shopdev shopdev-advertorial-reasons" data-section-id="{{ uid }}">
  <div class="adv__inner">
    <div class="adv__hero">
      {%- if section.settings.eyebrow != blank -%}<p class="adv__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h1 class="adv__title">{{ section.settings.heading }}</h1>{%- endif -%}
      {%- if section.settings.author_name != blank -%}
        <div class="adv__byline">
          {%- if section.settings.author_image != blank -%}{{ section.settings.author_image | image_url: width: 88 | image_tag: class: 'adv__byimg', alt: section.settings.author_name }}{%- else -%}<span class="adv__byph"></span>{%- endif -%}
          <div><div class="adv__byname">By <strong>{{ section.settings.author_name }}</strong></div>{%- if section.settings.date != blank -%}<div class="adv__bydate">{{ section.settings.date }}</div>{%- endif -%}</div>
        </div>
      {%- endif -%}
      {%- if section.settings.callout != blank -%}<div class="adv__callout">{{ section.settings.callout }}</div>{%- endif -%}
      {%- if section.settings.intro != blank -%}<div class="adv__intro">{{ section.settings.intro }}</div>{%- endif -%}
      {%- if section.settings.show_rating -%}<div class="adv__rating"><span class="adv__stars">★★★★★</span> {{ section.settings.rating_text }}</div>{%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <div class="adv__reason" {{ block.shopify_attributes }}>
        <div class="adv__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title, widths: '400, 600, 800' }}
          {%- else -%}
            <span class="adv__media-ph">Add image</span>
          {%- endif -%}
        </div>
        <div class="adv__text">
          <span class="adv__num">{{ forloop.index }}</span>
          {%- if block.settings.title != blank -%}<h2 class="adv__rtitle">{{ block.settings.title }}</h2>{%- endif -%}
          {%- if block.settings.body != blank -%}<div class="adv__body">{{ block.settings.body }}</div>{%- endif -%}
          {%- if block.settings.quote != blank -%}<blockquote class="adv__quote"><p>“{{ block.settings.quote }}”</p>{%- if block.settings.quote_author != blank -%}<cite>— {{ block.settings.quote_author }}</cite>{%- endif -%}</blockquote>{%- endif -%}
          {%- if block.settings.cta_text != blank -%}<a class="adv__cta" href="{{ block.settings.cta_link | default: '#' }}">{{ block.settings.cta_text }}</a>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Advertorial Reasons",
  "class": "shopdev shopdev-advertorial-reasons",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Editorial header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Hero headline", "info": "Wrap a word in <em> for the highlight colour.", "default": "7 reasons people are ditching melatonin for <em>Tranquil</em>" },
    { "type": "text", "id": "author_name", "label": "Author name", "default": "BKM Editorial" },
    { "type": "image_picker", "id": "author_image", "label": "Author photo" },
    { "type": "text", "id": "date", "label": "Date line", "default": "Last updated 2026" },
    { "type": "text", "id": "callout", "label": "Highlight callout", "default": "👉 Read this if you wake up tired even after 8 hours." },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>It's not more sleep you need. It's better sleep — here's why thousands are switching to Tranquil.</p>" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating line", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.6/5 from 36 reviews" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#0A2240" },
    { "type": "color", "id": "accent_2", "label": "Highlight color", "default": "#c1457f" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Reason title" },
        { "type": "richtext", "id": "body", "label": "Body" },
        { "type": "image_picker", "id": "image", "label": "Image (shown beside the text)" },
        { "type": "textarea", "id": "quote", "label": "Customer quote (optional)" },
        { "type": "text", "id": "quote_author", "label": "Quote author" },
        { "type": "text", "id": "cta_text", "label": "CTA button text (optional)" },
        { "type": "url", "id": "cta_link", "label": "CTA link" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [ { "name": "Advertorial Reasons" } ],
  "disabled_on": { "groups": ["header", "aside", "footer"] }
}
{% endschema %}
